FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-secret

# Relational event store (Feature 2). Use a driver connection string, not an ORM.
# Leave DATABASE_URL blank to use local SQLite at data/event_store.sqlite.
# Paste the connection string from the Somee panel, or an ODBC string:
# DATABASE_URL=data source=HOST;initial catalog=DATABASE;user id=USER;pwd=PASSWORD;TrustServerCertificate=True
DATABASE_URL=

# Demo credentials until Event Sourcing auth is implemented
HR_EMAIL=hr@example.com
HR_PASSWORD=changeme
CANDIDATE_EMAIL=candidate@example.com
CANDIDATE_PASSWORD=changeme
# More candidate logins. Each pair is email:password, separated by commas.
EXTRA_CANDIDATES=maya.cohen@example.com:maya-pass,omar.nasser@example.com:omar-pass

# Model provider: ollama (local Ollama in Docker) or mock (offline, no model).
# There is no automatic fallback. After switching, rebuild vectors: python -m src.projections
LLM_PROVIDER=mock
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.2
VECTOR_DB_PATH=./data/vector_store

# Read only by the screening-mcp server (python -m src.mcp_server), which the
# evaluation agent (python -m src.agents) starts. The agent never calls Tavily itself.
TAVILY_API_KEY=
