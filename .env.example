FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-secret

# Relational event store (Feature 2). Use a driver connection string, not an ORM.
# Leave DATABASE_URL blank to use local SQLite at data/event_store.sqlite.
# Paste the connection string from the Somee panel, or an ODBC string:
# DATABASE_URL=data source=HOST;initial catalog=DATABASE;user id=USER;pwd=PASSWORD;TrustServerCertificate=True
DATABASE_URL=

# Demo credentials until Event Sourcing auth is implemented
HR_EMAIL=hr@example.com
HR_PASSWORD=changeme
CANDIDATE_EMAIL=candidate@example.com
CANDIDATE_PASSWORD=changeme

# AI / vector store (later features)
OPENAI_API_KEY=sk-your-openai-api-key
VECTOR_DB_PATH=./data/vector_store
